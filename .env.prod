# ---- Frontend (React) config -------------------------------------------
PUBLIC_URL=http://localhost:3000
GENERATE_SOURCEMAP=false
REACT_APP_SERVERURL=http://localhost:8081/app
REACT_APP_APPID=opensign

# ---- Backend (Express/Parse) config -------------------------------------
appName=open_sign_server
# 12+ character random secret used by the Parse dashboard / server auth.
MASTER_KEY=XnAadwKxxByMr
MONGODB_URI=mongodb://opensign_user:opensign_pass@mongo-container:27017/OpenSignDB
PARSE_MOUNT=/app
SERVER_URL=http://localhost:8081/app
APP_ID=opensign

# ---- MongoDB root credentials (used only to enable auth + as an
# admin fallback; the app itself connects as opensign_user, see above) ----
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=rootpass

# ---- Storage config (LocalStack S3 instead of real DO/AWS) --------------
DO_SPACE=my-bucket
DO_ENDPOINT=s3.localhost.localstack.cloud:4566
DO_BASEURL=http://localhost:4566/my-bucket
DO_ACCESS_KEY_ID=test
DO_SECRET_ACCESS_KEY=test
DO_REGION=eu-central-1
USE_LOCAL=true

# ---- Email (disabled for local dev) --------------------------------------
SMTP_ENABLE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER_EMAIL=dev@example.com
SMTP_PASS=password

# ---- Document signing certificate ----------------------------------------
# Self-signed cert/passphrase — see README for how to generate your own.
PFX_BASE64=''
PASS_PHRASE=opensign